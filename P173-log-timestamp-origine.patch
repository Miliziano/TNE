+        let src_ts = raw.get("timestamp").and_then(|v| v.as_u64());
+        let wrapped = src_ts.is_some()
+            && raw.get("event").map(|e| e.is_object()).unwrap_or(false);
+        let mut ev = if wrapped {
+            raw.get("event").cloned().unwrap_or(Value::Null)
+        } else {
+            raw
