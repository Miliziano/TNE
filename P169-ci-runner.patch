diff --git a/.github/workflows/runner.yml b/.github/workflows/runner.yml
new file mode 100644
index 0000000..4fd5aa8
--- /dev/null
+++ b/.github/workflows/runner.yml
@@ -0,0 +1,74 @@
+name: Build runner
+
+# Compila il RUNNER headless (flowpilot_runner) per Linux e Windows, size-optimized.
+# NB: build SENZA Tauri (--no-default-features) → niente webview/webkit sui runner CI.
+on:
+  workflow_dispatch:            # avvio manuale
+  push:
+    tags: ['v*']               # e a ogni tag di release vX.Y.Z
+
+jobs:
+  build:
+    name: runner (${{ matrix.out }})
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            built: flowpilot_runner
+            out:   flowpilot-runner-linux-x64
+          - os: windows-latest
+            built: flowpilot_runner.exe
+            out:   flowpilot-runner-windows-x64.exe
+    steps:
+      - uses: actions/checkout@v4
+
+      # Su Linux servono OpenSSL (native-tls di lettre/ldap3/sqlx/reqwest/ssh2/suppaftp)
+      # e libdbus per il keyring (Secret Service). Su Windows: nulla (TLS+keychain nativi).
+      - name: Dipendenze di sistema (Linux)
+        if: runner.os == 'Linux'
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y pkg-config libssl-dev libdbus-1-dev
+
+      - name: Toolchain Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Cache cargo
+        uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: src-tauri
+
+      - name: Build runner (headless, size-optimized)
+        working-directory: src-tauri
+        run: cargo build --bin flowpilot_runner --no-default-features --profile release-lean
+
+      - name: Raccogli il binario
+        shell: bash
+        run: |
+          mkdir -p dist
+          cp "src-tauri/target/release-lean/${{ matrix.built }}" "dist/${{ matrix.out }}"
+
+      - name: Carica come artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ matrix.out }}
+          path: dist/${{ matrix.out }}
+
+  # Su tag vX.Y.Z: allega i binari alla GitHub Release.
+  release:
+    needs: build
+    if: startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - name: Scarica gli artifact
+        uses: actions/download-artifact@v4
+        with:
+          path: artifacts
+      - name: Pubblica sulla Release
+        uses: softprops/action-gh-release@v2
+        with:
+          files: artifacts/**/*
diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index ad027a2..e5247d2 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -79,3 +79,14 @@ futures-util = { version = "0.3", features = ["io"] }
 #   cargo build --bin flowpilot_runner --no-default-features --release
 default = ["desktop"]
 desktop = ["dep:tauri", "dep:tauri-plugin-log", "dep:tauri-plugin-fs", "dep:tauri-plugin-dialog", "dep:tauri-plugin-shell"]
+
+# Profilo per il RUNNER headless: ottimizzato per DIMENSIONE (non tocca il
+# profilo release dello studio). Build:
+#   cargo build --bin flowpilot_runner --no-default-features --profile release-lean
+[profile.release-lean]
+inherits      = "release"
+opt-level     = "z"      # ottimizza per dimensione
+lto           = true     # link-time optimization
+codegen-units = 1        # meno unità = binario più piccolo/ottimizzato
+panic         = "abort"  # niente unwinding (più piccolo; togliere se un dep lo richiede)
+strip         = true     # rimuove i simboli di debug
