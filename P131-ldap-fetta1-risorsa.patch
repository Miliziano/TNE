+function LdapConfig({ res, laneId }: { res: LaneResource; laneId: string }) {
+  const c = res.config
+  const f = (k: string) => c[k] ?? ''
+  const p = { laneId, resourceId: res.id }
+
+  const [testing, setTesting] = useState(false)
+  const [result, setResult]   = useState<{ ok: boolean; message: string } | null>(null)
+
+  async function runTest() {
+    setTesting(true)
+    setResult(null)
+    try {
+      const r = await invoke<{ ok: boolean; message: string; elapsed_ms: number }>('ldap_test', {
+        connection: {
+          host:                f('host'),
+          port:                parseInt(f('port') || '636', 10),
+          tls_mode:            f('tlsMode') || 'ldaps',
+          verify_cert:         (f('verifyCert') || 'true') === 'true',
+          bind_dn:             f('bindDN'),
+          password:            f('password'),
+          base_dn:             f('baseDN'),
+          connect_timeout_sec: parseInt(f('connectTimeout') || '10', 10),
+        },
+      })
+      setResult({ ok: r.ok, message: r.message })
+    } catch (e) {
+      setResult({ ok: false, message: e instanceof Error ? e.message : String(e) })
+    } finally {
+      setTesting(false)
+    }
+  }
+
+  return (
+    <>
+      <Section label="Connessione">
+        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
+          <Field label="Modalità TLS" fieldKey="tlsMode" value={f('tlsMode') || 'ldaps'}
+            type="select" options={['ldaps', 'starttls', 'plain']} {...p} />
+          <Field label="Porta" fieldKey="port" value={f('port') || '636'} type="number" {...p} />
+        </div>
+        <Field label="Host" fieldKey="host" value={f('host')} {...p} />
+        <Field label="Base DN" fieldKey="baseDN" value={f('baseDN')} {...p} />
+        <Field label="Verifica certificato" fieldKey="verifyCert" value={f('verifyCert') || 'true'}
+          type="select" options={['true', 'false']} {...p} />
+      </Section>
+
+      <Section label="Autenticazione (account di servizio)">
+        <Field label="Bind DN" fieldKey="bindDN" value={f('bindDN')} {...p} />
+        <Field label="Password" fieldKey="password" value={f('password')} type="password" {...p} />
+      </Section>
+
+      <Section label="Opzioni">
+        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
+          <Field label="Timeout conn. (s)" fieldKey="connectTimeout" value={f('connectTimeout') || '10'} type="number" {...p} />
+          <Field label="Dimensione pagina" fieldKey="pageSize" value={f('pageSize') || '500'} type="number" {...p} />
+        </div>
+      </Section>
+
+      <Section label="Test">
+        <button
+          onClick={runTest}
+          disabled={testing || !f('host')}
+          style={{
+            width: '100%', padding: '8px 12px', borderRadius: 6, cursor: testing ? 'default' : 'pointer',
+            background: '#1d6d40', color: '#eafff2', border: '0.5px solid #2a3349',
+            opacity: testing || !f('host') ? 0.5 : 1, fontSize: 13,
+          }}
+        >
+          {testing ? 'Test in corso…' : 'Test connessione'}
+        </button>
+        {result && (
+          <div style={{
+            marginTop: 8, padding: '7px 10px', borderRadius: 6, fontSize: 12, lineHeight: 1.4,
+            background: result.ok ? '#0d3d20' : '#3d1414',
+            border: `0.5px solid ${result.ok ? '#1d6d40' : '#6d1d1d'}`,
+            color: result.ok ? '#3ddc84' : '#ff8080', wordBreak: 'break-word',
+          }}>
+            {result.message}
+          </div>
+        )}
+      </Section>
+    </>
+  )
+}
