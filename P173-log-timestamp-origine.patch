+        // Tempo d'origine se presente; altrimenti (log nudo) ripiego sul tempo di ricezione.
+        let event_ts = src_ts.unwrap_or_else(now_ms);
+
         // run_id: nel payload (variante RunStarted/... ) o al livello superiore.
