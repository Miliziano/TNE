-// ─── Mini grafico heap (SVG) ──────────────────────────────────────
+// ─── Larghezza reale del contenitore (ResizeObserver) ────────────
+// Serve a disegnare gli SVG a pixel reali: così lo spessore delle
+// linee resta costante quando la finestra si allarga (niente "zoom"),
+// e il grafico guadagna risoluzione invece di scalare.
+function useWidth<T extends HTMLElement>(fallback = 300) {
+  const ref = useRef<T>(null)
+  const [w, setW] = useState(fallback)
+  useLayoutEffect(() => {
+    const el = ref.current
+    if (!el) return
+    const measure = () => { const cw = el.clientWidth; if (cw > 0) setW(cw) }
+    measure()
+    const ro = new ResizeObserver(measure)
+    ro.observe(el)
+    return () => ro.disconnect()
+  }, [])
+  return [ref, w] as const
+}
 
